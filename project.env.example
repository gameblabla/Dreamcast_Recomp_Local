# Copy to project.env and edit. Paths may be absolute or relative to this folder.

# 1. The game: a .gdi, .cue (+ .bin tracks), .iso, or a folder with the extracted files. Never committed.
DISC="/path/to/Game (Japan).cue"

# 2. Dreamcast SDK copies, ':'-separated. Folders, .iso or .zip. Put every release you have (e.g. 1.42J and 1.00J):
#    the one that matches the game's library banners is used for byte-matching, the others as header/name references.
#    `./dcre sdk` tells you exactly which release the game needs and whether you have it.
SDK_DIRS="/path/to/DREAMCAST SDK Ver 1.42J:/path/to/Dreamcast SDK for Sega Library Ver.1.00J"

# 3. Names (usually leave alone)
DR_PROJECT_NAME=drproject          # Ghidra project name
DR_BASE=0x8c010000                 # load address of 1ST_READ.BIN
# DR_LIB_START=8c089000            # optional: start of the linked-library region (hex) if you know it; triage classes it 'lib'
# DR_PORT_DIRS=src,port            # folders whose file names contain the 6/8-digit address of every finished function

# 4. Tools (auto-detected; override when needed)
# GHIDRA_HEADLESS=/usr/libexec/ghidra/support/analyzeHeadless
# DR_CC="sh-elf-gcc -O2 -m4-single-only -ml -c {src} -o {obj}"    # candidate compiler for bytematch/permute
