 	void send(const std::string& msg)
 	{
-		if (!msg.empty())
-		{
-			if (!outMessage.empty()) {
-				WARN_LOG(COMMON, "Message dropped: %s. Already sending: %s", msg.c_str(), outMessage.c_str());
